# Copy to .env.local. Never commit real values.

# Browser-safe (phase 6): RLS protects the data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scripts and GitHub Actions only — never prefix with NEXT_PUBLIC_.
# Supabase > Connect > "Session pooler" string (the direct host is IPv6-only; GitHub runners are not).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
ODDS_API_KEY=
# Hard monthly cap the ingest script refuses to exceed (free tier ≈ 500; 3 runs/day use ≤ 465)
ODDS_API_MONTHLY_CREDIT_CAP=470
# Later: results via football-data.org
FOOTBALL_DATA_API_KEY=
# GitHub Actions secret only: encrypts the weekly database backup
BACKUP_PASSPHRASE=
