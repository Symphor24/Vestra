# Copy to .env.local. Never commit real values.
# Phase 3 — Supabase (public URL + anon key are safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/CI only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4 — data providers (used only by scripts/ and GitHub Actions)
ODDS_API_KEY=
FOOTBALL_DATA_API_KEY=
# Hard monthly cap the ingest script refuses to exceed (free tier ≈ 500, keep a margin)
ODDS_API_MONTHLY_CREDIT_CAP=450
